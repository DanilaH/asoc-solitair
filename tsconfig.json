{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "Bundler", "resolveJsonModule": true, "isolatedModules": true,
    "noEmit": true, "strict": true, "skipLibCheck": true, "verbatimModuleSyntax": true,
    "noFallthroughCasesInSwitch": true, "types": ["vite/client", "node"]
  },
  "include": ["src", "tests", "tools", "*.config.ts"]
}
